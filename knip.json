{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/entrypoints/**/*.{ts,tsx}",
    "gait/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.spec.ts",
    "e2e/presentation.vite.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "gait/**/*.{ts,tsx}", "e2e/**/*.ts"],
  "ignore": ["src/types/**"],
  "ignoreUnresolved": ["bin/rails"],
  "ignoreDependencies": [
    "tailwindcss",
    "tailwindcss-react-aria-components",
    "@tailwindcss/forms",
    "@tailwindcss/typography",
    // Rails application layouts resolve these through importmap, outside the Vite package graph.
    "@hotwired/stimulus",
    "@hotwired/turbo-rails",
    "linkinator",
    // `.herb.yml` enables the Herb linter for editor template diagnostics.
    "@herb-tools/linter"
  ],
  "includeEntryExports": false,
  "exclude": ["types", "nsTypes", "catalog"]
}
