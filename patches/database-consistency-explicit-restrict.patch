+++ b/spec/checkers/jsonb_keys_uniqueness_spec.rb
@@ -0,0 +1,156 @@
+# frozen_string_literal: true
+
+RSpec.describe 'JSONB key uniqueness index matching', :postgresql do
+  let(:keys) { %w[transaction_public_id halt_generation] }
+  let(:options) { { keys: keys, conditions: -> { where(event_id: 18) } } }
+  let(:validator) do
+    double('JSONB key validator', kind: :jsonb_keys_uniqueness, attributes: [:context], options: options)
+  end
+  let(:model) { define_class }
+  let(:expression) { "(context ->> 'transaction_public_id'), (context ->> 'halt_generation')" }
+  let(:predicate) { 'event_id = 18' }
+  let(:unique) { true }
+
+  before do
+    define_database_with_entity do |table|
+      table.jsonb :context
+      table.jsonb :other_context
+      table.integer :event_id
+      table.integer :account_id
+      table.index expression, unique: unique, name: 'jsonb_keys_index', where: predicate
+    end
+    allow(model).to receive(:validators).and_return([validator])
+  end
+
+  let(:index) { model.connection_pool.with_connection { |connection| connection.indexes(model.table_name).first } }
+  let(:index_report) { DatabaseConsistency::Checkers::UniqueIndexChecker.new(model, index).report }
+  let(:validator_report) do
+    DatabaseConsistency::Checkers::MissingUniqueIndexChecker.new(model, :context, validator).report
+  end
+
+  it 'matches the real PostgreSQL expression index in both directions' do
+    expect(index.columns).to include('::text')
+    expect(index_report.status).to eq(:ok)
+    expect(validator_report.status).to eq(:ok)
+  end
+
+  context 'with keys in reversed order' do
+    let(:keys) { %w[halt_generation transaction_public_id] }
+
+    it 'matches in both directions' do
+      expect(index_report.status).to eq(:ok)
+      expect(validator_report.status).to eq(:ok)
+    end
+  end
+
+  context 'with an ordinary scope' do
+    let(:options) { super().merge(scope: :account_id) }
+    let(:expression) { "#{super()}, account_id" }
+
+    it 'matches the scope as well as the exact JSON keys' do
+      expect(index_report.status).to eq(:ok)
+      expect(validator_report.status).to eq(:ok)
+    end
+  end
+
+  context 'with punctuation, quotes and case in keys' do
+    let(:keys) { ["A,b' (x)", 'lower(Key)'] }
+    let(:expression) { "(context ->> 'A,b'' (x)'), (context ->> 'lower(Key)')" }
+
+    it 'preserves literal key contents' do
+      expect(index_report.status).to eq(:ok)
+      expect(validator_report.status).to eq(:ok)
+    end
+  end
+
+  {
+    'a wrong key' => %w[transaction_public_id wrong],
+    'a missing key' => %w[transaction_public_id],
+    'an extra key' => %w[transaction_public_id halt_generation extra],
+    'a differently cased key' => %w[Transaction_public_id halt_generation],
+    'duplicate metadata' => %w[transaction_public_id transaction_public_id],
+    'empty metadata' => [],
+    'missing metadata' => nil,
+    'non-string metadata' => %i[transaction_public_id halt_generation],
+    'an empty key' => ['', 'halt_generation']
+  }.each do |description, declared_keys|
+    context "with #{description}" do
+      let(:keys) { declared_keys }
+
+      it 'fails both directions' do
+        expect(index_report.status).to eq(:fail)
+        expect(validator_report.status).to eq(:fail)
+      end
+    end
+  end
+
+  {
+    'a different JSON column' => "(other_context ->> 'transaction_public_id'), (context ->> 'halt_generation')",
+    'the JSON rather than text operator' => "(context -> 'transaction_public_id'), (context -> 'halt_generation')",
+    'an additional expression' => "(context ->> 'transaction_public_id'), (context ->> 'halt_generation'), account_id",
+    'a wrapped function' => "lower(context ->> 'transaction_public_id'), (context ->> 'halt_generation')"
+  }.each do |description, index_expression|
+    context "with #{description}" do
+      let(:expression) { index_expression }
+
+      it 'fails both directions' do
+        expect(index_report.status).to eq(:fail)
+        expect(validator_report.status).to eq(:fail)
+      end
+    end
+  end
+
+  context 'with a different partial predicate' do
+    let(:predicate) { 'event_id = 19' }
+
+    it 'fails both directions' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'with no partial predicate' do
+    let(:predicate) { nil }
+
+    it 'fails both directions' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'with a missing scope column' do
+    let(:options) { super().merge(scope: :account_id) }
+
+    it 'fails both directions' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'with distinct literal whitespace' do
+    let(:keys) { ['transaction public_id', 'halt_generation'] }
+    let(:expression) { "(context ->> 'transaction  public_id'), (context ->> 'halt_generation')" }
+
+    it 'does not normalize distinct JSON keys together' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'with unsupported case-insensitive extraction' do
+    let(:options) { super().merge(case_sensitive: false) }
+
+    it 'fails both directions' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'with no unique constraint' do
+    let(:unique) { false }
+
+    it 'reports the missing unique index' do
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+end
