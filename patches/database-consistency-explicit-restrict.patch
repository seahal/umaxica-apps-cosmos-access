+# frozen_string_literal: true
+
+RSpec.describe 'Partial uniqueness with a null-skipping validator', :postgresql do
+  let(:klass) do
+    define_class do |model|
+      model.validates :owner_id, uniqueness: { scope: :purpose, conditions: -> { where(status_id: [10, 20, 30]) } },
+                                 allow_nil: allow_nil
+    end
+  end
+  let(:allow_nil) { true }
+  let(:predicate) { 'owner_id IS NOT NULL AND status_id IN (10, 20, 30)' }
+  let(:validator) { klass.validators.find { |item| item.kind == :uniqueness } }
+  let(:index) { klass.connection_pool.with_connection { |connection| connection.indexes(klass.table_name).first } }
+  let(:index_report) { DatabaseConsistency::Checkers::UniqueIndexChecker.new(klass, index).report }
+  let(:validator_report) do
+    DatabaseConsistency::Checkers::MissingUniqueIndexChecker.new(klass, :owner_id, validator).report
+  end
+
+  before do
+    define_database_with_entity do |table|
+      table.integer :owner_id
+      table.string :purpose
+      table.integer :status_id
+      table.integer :other_id
+      table.index %i[owner_id purpose], unique: true, name: 'partial_guard_index', where: predicate
+    end
+  end
+
+  it 'matches the equivalent PostgreSQL index in both directions' do
+    expect(index_report.status).to eq(:ok)
+    expect(validator_report.status).to eq(:ok)
+  end
+
+  context 'when nil is validated rather than skipped' do
+    let(:allow_nil) { false }
+
+    it 'does not equate a null-excluding index with a validator that checks nil' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'when the guard excludes a different column' do
+    let(:predicate) { 'other_id IS NOT NULL AND status_id IN (10, 20, 30)' }
+
+    it 'reports the mismatch in both directions' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'when the guarded status set differs' do
+    let(:predicate) { 'owner_id IS NOT NULL AND status_id IN (10, 20)' }
+
+    it 'reports the mismatch in both directions' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+
+  context 'when null guard is an alternative rather than a conjunction' do
+    let(:predicate) { 'owner_id IS NOT NULL OR status_id IN (10, 20, 30)' }
+
+    it 'reports the mismatch in both directions' do
+      expect(index_report.status).to eq(:fail)
+      expect(validator_report.status).to eq(:fail)
+    end
+  end
+end
