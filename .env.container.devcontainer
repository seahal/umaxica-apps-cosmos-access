# Umaxica Global local development contract (non-secret defaults) for the Dev Container, the only
# supported development runtime. .devcontainer/compose.yaml loads it into `core`; put local
# overrides in the ignored .env. Never put production credentials or tokens in this file.
# PostgreSQL connection settings are not here: config/database.yml fixes the development and test
# targets (`primary`, `replica`, root/development) so no exported variable can redirect them.
NODE_ENV=development
# Trusted execution role (lib/runtime_role.rb). `shared` is the transitional single-process role
# that serves every surface; per-role processes use e.g. rp-core-app-jp. Every role reads the same
# config/credentials/development.yml.enc.
UMAXICA_RUNTIME_ROLE=shared
# Only `rp-*` cell processes read UMAXICA_RP_BROWSER_ADMISSION (open|closed); the shared role does
# not, so it is not set here.
# Trusted deployment region for regional RP client IDs (app/values/rp_deployment_binding_value.rb).
# Never derived from request input; jp is the only provisioned development region.
UMAXICA_DEPLOYMENT_REGION=jp
# Puma: 2 workers x 5 threads = 10 request slots (D-120; provisional development values).
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
PORT=3000
BINDING=0.0.0.0
BRAND_NAME=UMAXICA
TMPDIR=/home/global/workspace/tmp
BUNDLE_PATH=vendor/bundle
VITE_RUBY_HOST=0.0.0.0
VITE_RUBY_PORT=3036
VITE_RUBY_PACKAGE_MANAGER=bun
VITE_GIT_HOOKS=0
# Databases that `db:test:prepare` is allowed to migrate. DatabaseSafety fetches this
# name with no default, so `bin/rails test` aborts before any schema work when it is
# unset -- the guard is deliberate: an implicit default could migrate a database the
# run was never meant to touch. This lists every test writer database, which is wider
# than the `db:test:prepare` step in config/ci.rb on purpose: CI starts from databases it
# has just created, whereas a devcontainer's test databases persist, so a migration added
# to a database outside this list would leave `bin/rails test` aborting on "Migrations
# are pending". Add the writer here when a new database joins config/database.yml.
POSTGRESQL_TEST_PREPARE_DATABASES=test_app_setting_db,test_app_signal_db,test_app_zenith_db,test_avatar_db,test_chronicle_db,test_com_setting_db,test_occurrence_db,test_op_base_app_db,test_op_base_org_db,test_org_setting_db,test_org_signal_db,test_org_zenith_db,test_primary_db,test_publishing_db,test_queue_db,test_rp_base_app_db,test_rp_base_org_db,test_rp_core_app_db,test_rp_core_org_db,test_rp_edit_org_db,test_rp_palm_app_db,test_rp_tech_org_db,test_rp_warp_app_db,test_rp_warp_org_db,test_search_db
# Canonical nonprod Valkey endpoints (Compose DNS). config/valkey.yml binds
# responsibilities to these hosts and logical DBs. Do not also set
# CACHE_/RATE_LIMIT_/AUTH_STATE_REDIS_URL here; those names are production URL keys.
VALKEY_CACHE_HOST=valkey-cache
VALKEY_CACHE_PORT=6379
VALKEY_KVS_HOST=valkey-kvs
VALKEY_KVS_PORT=6379
VALKEY_DIAGNOSTIC_HOST=valkey
VALKEY_DIAGNOSTIC_PORT=6379
AWS_SES_REGION=ap-northeast-1
SMS_PROVIDER=test
ENFORCEMENT_APP_IDENTIFIER_HMAC_KEY=development_enforcement_app_identifier_hmac_key
ENFORCEMENT_ORG_IDENTIFIER_HMAC_KEY=development_enforcement_org_identifier_hmac_key
FLIPPER_UI_USER=admin
FLIPPER_UI_PASSWORD=pass
BLAZER_USERNAME=admin
BLAZER_PASSWORD=pass
PGHERO_USERNAME=admin
PGHERO_PASSWORD=pass
AUTH_JWT_CLIENT_AUDIENCES=umaxica-api-client
AUTH_JWT_OPERATOR_AUDIENCES=umaxica-api-operator
AUTH_JWT_CLIENT_CLIENT_ID=umaxica-web-client
AUTH_JWT_OPERATOR_CLIENT_ID=umaxica-web-operator
PUBLIC_AUTH_SERVICE_URL=auth.umaxica.app
PUBLIC_AUTH_STAFF_URL=auth.umaxica.org
PUBLIC_BASE_SERVICE_URL=www.umaxica.app
PUBLIC_BASE_STAFF_URL=www.umaxica.org
PUBLIC_VISA_SERVICE_URL=visa.umaxica.app
PUBLIC_VISA_STAFF_URL=visa.umaxica.org
PUBLIC_EDIT_STAFF_URL=edit.umaxica.org
PUBLIC_TECH_STAFF_URL=tech.umaxica.org
PUBLIC_MISSION_URL=mission.umaxica.dev
PRIVATE_MISSION_URL=mission.core.dev.localhost
PUBLIC_FLIPPER_URL=flipper.umaxica.dev
PRIVATE_FLIPPER_URL=flipper.core.dev.localhost
PUBLIC_BLAZER_URL=blazer.umaxica.dev
PRIVATE_BLAZER_URL=blazer.core.dev.localhost
PUBLIC_PGHERO_URL=pghero.umaxica.dev
PRIVATE_PGHERO_URL=pghero.core.dev.localhost
PUBLIC_WARP_SERVICE_URL=www-jp.umaxica.app
PUBLIC_WARP_STAFF_URL=www-jp.umaxica.org
PUBLIC_CORE_SERVICE_URL=jp.umaxica.app
PUBLIC_CORE_STAFF_URL=jp.umaxica.org
PUBLIC_PALM_SERVICE_URL=palm-jp.umaxica.app
PUBLIC_ASSET_URL=asset.umaxica.net
PRIVATE_AUTH_SERVICE_URL=auth.app.localhost
PRIVATE_AUTH_STAFF_URL=auth.org.localhost
PRIVATE_VISA_SERVICE_URL=visa.app.localhost
PRIVATE_VISA_STAFF_URL=visa.org.localhost

LANG=C.UTF-8
LC_ALL=C.UTF-8
RUBY_PATH=/usr/local/bin/ruby
RUBY_DEBUG_OPEN=false
TZ=UTC
DEVCONTAINER=1
OPEN_TELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# --- Jump gateway --------------------------------------------------------------
# PUBLIC_JUMP_GATEWAY_URL is the only Jump gateway setting: the browser-facing public HTTPS
# root origin, with no default. The gateway JWKS URI (<origin>/.well-known/jwks.json) and the
# Jump RT audience (the origin itself) are derived from it and cannot be configured separately.
# The removed settings JUMP_GATEWAY_URL, *_JWKS_URL and *_AUDIENCE are rejected at boot if
# Each Jump issuer identity (and its return origin and JWKS URI) comes from the existing
# PUBLIC_{AUTH,BASE,CORE,WARP}_{SERVICE,CORPORATE,STAFF}_URL and PUBLIC_PALM_SERVICE_URL values;
# there are no Jump-specific issuer or development key settings. Rails.env does not change the
# identity: when development uses a canonical origin, that origin's /.well-known/jwks.json must
# publish the local key from tmp/local_jwt_keysets.json, and that key then signs as the
# canonical issuer. localhost and private ingress names are never Jump identities. A Jump
# emulator is not implemented; a future one needs its own explicit security contract.
PUBLIC_JUMP_GATEWAY_URL=https://jump.umaxica.net
# --- Diagnostic surfaces -----------------------------------------------------
# Three development-only dashboards, each on its own dedicated host behind HTTP
# Basic Auth. See adr/diagnostic-surfaces-performance-coverband-swagger.md.
#
# PUBLIC_* is the name a browser sees; PRIVATE_* is the network-side ingress the
# Cloudflare Tunnel connector reaches. Both are exact FQDNs -- no wildcard is
# admitted anywhere, so a spoofed Host cannot reach one dashboard through
# another's name.
PUBLIC_COVERBAND_URL=coverband.umaxica.dev
PRIVATE_COVERBAND_URL=coverband.core.dev.localhost
PUBLIC_SWAGGER_URL=swagger.umaxica.dev
PRIVATE_SWAGGER_URL=swagger.core.dev.localhost

# Diagnostic dashboards stay on VALKEY_DIAGNOSTIC_HOST (compatibility `valkey`).
# Logical DBs 12/13 are declared in config/valkey.yml. Do not point Coverband
# or Coverband at cache or KVS.

# Read through Rails.app.creds.option, which checks ENV first and then Rails
# credentials. With the password left unset, each surface answers 401 -- the guards
# fail closed. The *_PASSWORD names are absent here on purpose: Compose exports every
# name in this file, and an exported empty value would shadow the password set in the
# gitignored `.env`.
COVERBAND_USERNAME=admin
SWAGGER_USERNAME=admin

# Optional per-surface switches. Both default to on. Only the exact string
# "false" disables, so a typo cannot silently turn observability off.
# Swagger has no toggle of its own: unset its PUBLIC_/PRIVATE_ pair above and
# the host drops out of both the route constraint and Host Authorization.
COVERBAND_ENABLED=true
# Explicit non-secret local Secret retention lifetimes used by the retention worker.
APP_SECRET_PURGE_DELAY_SECONDS=86400
APP_SECRET_OUTBOX_RETENTION_SECONDS=604800
APP_SECRET_PROOF_RETENTION_SECONDS=2592000
APP_SECRET_ISSUANCE_TTL_SECONDS=600
# Non-secret local dead-history keys. Production supplies independent secrets.
APP_EMAIL_HISTORY_KEY=local-app-email-dead-history-key
APP_TELEPHONE_HISTORY_KEY=local-app-telephone-dead-history-key
ORG_EMAIL_HISTORY_KEY=local-org-email-dead-history-key
ORG_TELEPHONE_HISTORY_KEY=local-org-telephone-dead-history-key
# Non-secret local ceremony verifier keys. Production supplies independent secrets.
APP_EMAIL_OTP_VERIFIER_KEY=local-app-email-otp-verifier-key
APP_TELEPHONE_OTP_VERIFIER_KEY=local-app-telephone-otp-verifier-key
ORG_EMAIL_OTP_VERIFIER_KEY=local-org-email-otp-verifier-key
ORG_TELEPHONE_OTP_VERIFIER_KEY=local-org-telephone-otp-verifier-key
# Non-secret local identifier encryption keyrings. Production supplies independent secrets.
APP_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=local-app-identifier-encryption-primary
APP_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=local-app-identifier-encryption-derivation
ORG_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=local-org-identifier-encryption-primary
ORG_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=local-org-identifier-encryption-derivation
# Non-secret local realm identifier keys. Production must provide independent secrets.
# Realm-specific identity digest keys
APP_EMAIL_ADDRESS_HMAC_KEY=local-app-email-identifier-key
APP_TELEPHONE_NUMBER_HMAC_KEY=local-app-telephone-identifier-key
ORG_EMAIL_ADDRESS_HMAC_KEY=local-org-email-identifier-key
ORG_TELEPHONE_NUMBER_HMAC_KEY=local-org-telephone-identifier-key
