<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>" data-edition="org">
<head>
  <meta charset="utf-8">
  <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (ORG)",
                        title: page_title,
                        separator: "—",
                        reverse: true %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta property="csp-nonce" nonce="<%= content_security_policy_nonce %>">
  <%= stylesheet_link_tag "application", nonce: true %>
  <%= javascript_importmap_tags %>
  <%= render "layouts/shared/cloudflare_turnstile_api" %>
</head>
<body class="ui-document">
  <%= render "shared/ui/skip_link" %>
  <header>
    <%= render "layouts/shared/flash_messages" %>
    <%= render "layouts/shared/current_banner", tld: :org, domain: :sign, region: :global %>
    <p><strong><%= ENV.fetch("BRAND_NAME") %></strong> (org)</p>
  </header>

  <main id="main" class="ui-main" tabindex="-1">
    <%= yield %>
  </main>

  <footer>
    <div>
      <%= render "layouts/shared/copyright" %>
    </div>
  </footer>
</body>
</html>
